PORT=3000
NODE_ENV=development

# Genera un valor aleatorio largo y mantenlo fuera del frontend.
JWT_SECRET=replace_with_a_long_random_secret

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=home_gardener_db

# Alternativa a DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DB_URL=postgresql://user:password@host:5432/database
# Para habilitar verificación TLS solo desactívala en entornos con certificados privados.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Orígenes web separados por coma; no se usan cookies de sesión.
FRONTEND_URL=http://localhost:8081

# Storage opcional para fotos de perfil; nunca expongas la clave service role al cliente.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_BUCKET=Fotos
